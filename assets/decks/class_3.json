          "title": "Plants and Animals Around Us",
          "pairs": [["Cow", "Calf"], ["Dog", "Puppy"], ["Cat", "Kitten"], ["Hen", "Chick"]],
          "cards": [
            {"id": "c3v1-01", "front": "Which part of a plant makes its food?", "back": "Leaf", "explain": "Leaves use sunlight, air and water to make food.", "wrong": ["Root", "Stem", "Flower"]},
            {"id": "c3v1-02", "front": "Which part of a plant takes in water from the soil?", "back": "Root", "explain": "Roots grow into the soil and soak up water.", "wrong": ["Leaf", "Flower", "Fruit"]},
            {"id": "c3v1-03", "front": "Which animal gives us wool?", "back": "Sheep", "explain": "Sheep grow thick wool, which is cut off without hurting them.", "wrong": ["Cow", "Hen", "Dog"]},
            {"id": "c3v1-04", "front": "Which animal is called the 'ship of the desert'?", "back": "Camel", "explain": "Camels can walk a long way in the hot desert without water.", "wrong": ["Horse", "Elephant", "Donkey"]},
            {"id": "c3v1-05", "front": "What do we call a baby cow?", "back": "Calf", "wrong": ["Kid", "Cub", "Puppy"]},
            {"id": "c3v1-06", "front": "Where does a bird lay its eggs?", "back": "In a nest", "wrong": ["In a den", "In a stable", "In a burrow"]}
