            {"id": "c7m1-03", "front": "(−20) ÷ 4 = ?", "back": "-5", "explain": "Negative ÷ positive = negative.", "wrong": ["5", "-16", "-80"]},
            {"id": "c7m1-04", "front": "Which is greater: −3 or −7?", "back": "-3", "explain": "−3 is to the right of −7 on the number line.", "wrong": ["-7"]},
            {"id": "c7m1-05", "front": "What is the additive inverse of 9?", "back": "-9", "explain": "9 + (−9) = 0.", "wrong": ["9", "1/9", "0"]}
