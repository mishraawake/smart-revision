            {"id": "c7s1-04", "front": "An acid reacts with a base to form salt and water. What is this reaction called?", "back": "Neutralisation", "explain": "An antacid neutralises extra acid in the stomach.", "wrong": ["Rusting", "Evaporation", "Crystallisation"]},
            {"id": "c7s1-05", "front": "Turmeric paper turns which colour in a basic solution?", "back": "Red", "explain": "Turmeric is a natural indicator. It stays yellow in acids.", "wrong": ["Yellow", "Blue", "Green"]}
