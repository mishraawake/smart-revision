            {"id": "c5m1-02", "front": "Which is bigger: 1/2 or 1/4?", "back": "1/2", "explain": "Half a roti is more than a quarter of the same roti.", "wrong": ["1/4"]},
            {"id": "c5m1-03", "front": "1/2 is the same as which fraction?", "back": "2/4", "explain": "2 quarters make a half.", "wrong": ["1/4", "3/4", "4/4"]},
            {"id": "c5m1-04", "front": "What is half of 50?", "back": "25", "explain": "50 ÷ 2 = 25", "wrong": ["20", "100", "15"]},
