            {"id": "c4m1-02", "front": "What is 9 × 0?", "back": "0", "explain": "Any number times zero is zero.", "wrong": ["9", "1", "90"]},
            {"id": "c4m1-03", "front": "A tricycle has 3 wheels. How many wheels do 5 tricycles have?", "back": "15", "explain": "5 × 3 = 15", "wrong": ["8", "12", "18"]},
            {"id": "c4m1-04", "front": "What is 12 × 10?", "back": "120", "explain": "To multiply by 10, put a 0 at the end.", "wrong": ["22", "1200", "102"]},
            {"id": "c4m1-05", "front": "Which is the same as 4 × 3?", "back": "3 × 4", "explain": "Changing the order of multiplying does not change the answer.", "wrong": ["4 + 3", "4 − 3", "43"]}
          ]
        },
