          "title": "Describing Words",
          "cards": [
            {"id": "c4e1-01", "front": "Find the describing word: a tall tree", "back": "tall", "explain": "A describing word (adjective) tells us more about a noun.", "wrong": ["tree", "a"]},
            {"id": "c4e1-02", "front": "big → ? (comparing two things)", "back": "bigger", "explain": "big, bigger, biggest. Double the g before adding -er.", "wrong": ["more big", "biger", "biggest"]},
            {"id": "c4e1-03", "front": "Which is a describing word: soft, jump or chair?", "back": "soft", "wrong": ["jump", "chair"]},
            {"id": "c4e1-04", "front": "What is the opposite of 'brave'?", "back": "cowardly", "wrong": ["strong", "bold", "kind"]},
            {"id": "c4e1-05", "front": "Choose the right word: ___ elephant", "back": "an", "explain": "Use 'an' before a vowel sound: an elephant, an apple.", "wrong": ["a"]}
          ]
